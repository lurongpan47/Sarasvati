{
  "name": "@sarasvati/buddhist-ai-guardrail",
  "version": "0.1.0",
  "description": "Reference runtime implementation of the BUDDHIST-AI-CHARTER v1.0 — bodhicitta as an algorithmic constraint. TypeScript starter kit (API parity with the Python reference).",
  "keywords": [
    "ai",
    "ethics",
    "guardrail",
    "buddhism",
    "charter",
    "safety",
    "alignment"
  ],
  "license": "CC-BY-SA-4.0",
  "author": "Sarasvatī Project <sarasvati.canon@proton.me>",
  "homepage": "https://github.com/lurongpan47/Sarasvati",
  "repository": {
    "type": "git",
    "url": "https://github.com/lurongpan47/Sarasvati.git",
    "directory": "impl/typescript"
  },
  "bugs": {
    "url": "https://github.com/lurongpan47/Sarasvati/issues"
  },
  "type": "module",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build:esm": "tsc -p tsconfig.build.json",
    "build:cjs": "node scripts/build-cjs.mjs",
    "build": "npm run clean && npm run build:esm && npm run build:cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "example": "tsx examples/demo.ts"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.4",
    "vitest": "^1.6.0"
  }
}
